{
  "manifest_version": 3,
  "name": "ARF Browser Field Inspector (Read Only)",
  "version": "0.1.0",
  "description": "Read-only field safety diagnostics. No text capture or correction.",
  "action": {
    "default_title": "ARF Browser Inspector (read-only)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["classifier.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}